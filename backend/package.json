{
  "name": "kitkop-backend",
  "version": "1.0.0",
  "description": "Backend API - Sistem Informasi Pemesanan Menu Cafe Kitkop",
  "main": "server.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "migrate:settings": "node migrations/add-settings-and-service-charge.js",
    "migrate:menu-options": "node migrations/add-menu-options.js",
    "migrate:order-counters": "node migrations/add-order-counters.js",
    "migrate:qris-attempts": "node migrations/add-qris-attempts.js",
    "migrate:staff-roles": "node migrations/add-barista-role.js",
    "migrate:recipe-quantities": "node migrations/validate-recipe-quantities.js",
    "migrate:menu-prices": "node migrations/validate-menu-prices.js",
    "migrate:staff-sessions": "node migrations/add-session-versions.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "8.7.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.3",
    "sharp": "0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {},
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
