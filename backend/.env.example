# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=kitkop_db
DB_SSL=false

# JWT
JWT_SECRET=your_jwt_secret_here

# Server
PORT=5000
# Optional comma-separated IPs/CIDRs of actual reverse proxies; empty = trust none.
# Do not set arbitrary/public client ranges. See docs/login-rate-limiting.md.
TRUSTED_PROXY_CIDRS=
# Optional absolute directory for menu images; default: backend/uploads/menus
MENU_UPLOAD_DIR=

# KuyzPay Payment Gateway (use credentials for the intended environment)
KUYZPAY_MERCHANT_ID=your_kuyzpay_merchant_id
KUYZPAY_SECRET=your_kuyzpay_secret_here
KUYZPAY_BASE_URL=https://api.kuyzpay.xyz/api/v1

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
